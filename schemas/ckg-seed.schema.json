{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/manage-ckg/schemas/ckg-seed.schema.json",
  "title": "CKG Seed Bundle",
  "type": "object",
  "required": ["domain", "title", "sources", "concepts", "edges"],
  "additionalProperties": true,
  "properties": {
    "domain": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "concepts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/concept"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["id", "title"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "path": { "type": "string" },
        "url": { "type": "string" },
        "source_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "visibility": { "type": "string", "enum": ["public", "internal", "restricted", "private"] },
        "kind": { "type": "string" }
      },
      "anyOf": [
        { "required": ["path"] },
        { "required": ["url"] }
      ]
    },
    "concept": {
      "type": "object",
      "required": ["id", "title", "type", "summary"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "taxonomy": { "type": "string" },
        "status": { "type": "string", "enum": ["draft", "active", "stable", "stale", "deprecated", "rejected"] },
        "review_state": { "type": "string", "enum": ["unreviewed", "reviewed", "needs_review"] },
        "visibility": { "type": "string", "enum": ["public", "internal", "restricted", "private"] },
        "summary": { "type": "string", "minLength": 1 },
        "why_it_matters": { "type": "string" },
        "sources": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "edge": {
      "type": "object",
      "required": ["source", "target", "type", "rationale"],
      "additionalProperties": true,
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "enum": ["REQUIRES", "ENABLES", "IMPLEMENTS", "RELATES_TO"] },
        "rationale": { "type": "string", "minLength": 1 }
      }
    }
  }
}
